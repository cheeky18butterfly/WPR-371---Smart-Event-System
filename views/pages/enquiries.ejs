<%- include('../partials/navbar') %>

<h1>User Enquiries</h1>

<div class="enquiry-list">

    <% enquiries.forEach((e, index) => { %>

    <div class="enquiry-card">

        <h3><%= e.name %></h3>
        <p><%= e.email %></p>
        <p><%= e.message %></p>
        <small><%= e.date %></small>

        <a href="/admin/delete-enquiry/<%= index %>" class="delete-btn">
            Delete
        </a>

    </div>

<% }) %>
</div>

<%- include('../partials/footer') %>