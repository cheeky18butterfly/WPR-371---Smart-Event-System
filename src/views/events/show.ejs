<section class="container page-section">
  <a class="back-link" href="/">Back to events</a>
  <div class="detail-layout">
    <img class="detail-image" src="<%= event.imageUrl %>" alt="">
    <article class="detail-content">
      <p class="eyebrow"><%= event.category %></p>
      <h1><%= event.title %></h1>
      <p><%= event.description %></p>
      <div class="stats-grid">
        <span><strong>Date</strong><%= event.date.toLocaleString('en-ZA', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
        <span><strong>Venue</strong><%= event.venue %></span>
        <span><strong>Price</strong>R<%= event.price.toFixed(2) %></span>
        <span><strong>Availability</strong><%= event.availableTickets %> of <%= event.capacity %> tickets</span>
      </div>

      <% if (currentUser) { %>
        <% if (event.availableTickets > 0) { %>
          <form class="booking-form" action="/bookings/events/<%= event._id %>" method="POST">
            <label for="quantity">Tickets</label>
            <input id="quantity" type="number" name="quantity" min="1" max="<%= Math.min(event.availableTickets, 10) %>" value="1" required>
            <button class="button" type="submit">Book Tickets</button>
          </form>
        <% } else { %>
          <div class="empty-state">This event is sold out.</div>
        <% } %>
      <% } else { %>
        <a class="button" href="/auth">Login to Book</a>
      <% } %>
    </article>
  </div>
</section>
